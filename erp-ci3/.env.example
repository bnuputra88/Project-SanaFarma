# SanaFarma (PharmaERP) — contoh environment. Salin ke .env dan sesuaikan.
# JANGAN commit file .env sesungguhnya (sudah di .gitignore).

APP_ENV=development
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
LOG_THRESHOLD=1

# Database (MySQL 8 / InnoDB)
DB_HOST=mysql
DB_PORT=3306
DB_USER=pharma
DB_PASSWORD=change-me
DB_NAME=pharma_erp

# Auth / keamanan
JWT_SECRET=ganti-dengan-string-acak-panjang-min-32-char
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
SESSION_TIMEOUT=1800
SESSION_SINGLE_DEVICE=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=120

# Admin awal (dipakai seeder, idempoten)
ADMIN_EMAIL=admin@sehatfarma.test
ADMIN_PASSWORD=Admin#2026!Secure
